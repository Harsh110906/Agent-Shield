# AgentShield Environment Variables

# Backend
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database (defaults to sqlite in memory/file if not set, but can be postgres)
DATABASE_URL=sqlite:///./agentshield.db

# LLM Provider Configuration
# Set to 'demo' to run deterministic mock agents without API keys
LLM_PROVIDER=demo
# Example: LLM_PROVIDER=openai
# LLM_MODEL=gpt-4-turbo
# LLM_API_KEY=sk-placeholder

# Security
SECRET_KEY=generate-a-strong-secret-key-for-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
